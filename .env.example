# ===========================================
# Railway automatycznie ustawi DATABASE_URL
# po dodaniu PostgreSQL w dashboardzie.
# W produkcji aplikacja sama doda connection_limit=5, jeśli brak.
# Możesz też ręcznie: .../mydb?connection_limit=5
# ===========================================
DATABASE_URL="postgresql://user:password@localhost:5432/margonem_timer"

# JWT secret — zmień na coś losowego!
# Wygeneruj np. przez: openssl rand -base64 32
JWT_SECRET="zmien-mnie-na-cos-losowego-i-dlugiego-1234567890"

# Environment
NODE_ENV="production"

# Opcjonalnie: SMTP do przypomnienia hasła (można też ustawić w panelu /admin/ustawienia)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="konto@gmail.com"
# SMTP_PASS="haslo-aplikacji"
# SMTP_FROM="noreply@twoja-domena.pl"
# SMTP_FROM_NAME="Guardians of Souls"
# APP_URL="https://twoja-domena.pl"
